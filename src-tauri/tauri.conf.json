{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-whisper",
  "version": "0.1.0",
  "identifier": "dev.hadi.mywhisper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "/overlay",
        "title": "my-whisper",
        "width": 300,
        "height": 72,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "settings",
        "url": "/settings",
        "title": "my-whisper — Settings",
        "width": 520,
        "height": 640,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
