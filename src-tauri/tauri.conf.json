{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zemzeme",
  "mainBinaryName": "zemzeme",
  "version": "0.1.0",
  "identifier": "io.github.mhrezaei.zemzeme",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "/overlay",
        "title": "Zemzeme",
        "width": 300,
        "height": 72,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "settings",
        "url": "/settings",
        "title": "Zemzeme — Settings",
        "width": 560,
        "height": 760,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Speech to text at your cursor",
    "longDescription": "Press a shortcut, speak, and the text is typed where your cursor is. Uses OpenRouter speech-to-text models.",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "pipewire-bin"
        ],
        "section": "utils",
        "files": {
          "/usr/lib/udev/rules.d/70-zemzeme-uinput.rules": "../packaging/70-zemzeme-uinput.rules"
        },
        "postInstallScript": "../packaging/postinst.sh",
        "postRemoveScript": "../packaging/postrm.sh"
      }
    }
  }
}
