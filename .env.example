# Copy to .env (never committed) for development.
OPENROUTER_API_KEY=
# Optional
ZEMZEME_MODEL=openai/gpt-4o-transcribe
ZEMZEME_LANG=fa
# Microphone id from `zemzeme mics`; empty = system default
ZEMZEME_MIC=
# Paste shortcut: ctrl+v | ctrl+shift+v | shift+insert
ZEMZEME_PASTE_KEY=ctrl+v
# Cleanup step: write English terms in Latin letters (on/off)
ZEMZEME_CLEANUP=on
ZEMZEME_CLEANUP_MODEL=google/gemini-3.1-flash-lite
# Words to spell exactly, comma separated
ZEMZEME_VOCAB=
# Keep every recording in ~/.cache/io.github.mhrezaei.zemzeme/recordings (troubleshooting)
ZEMZEME_KEEP_AUDIO=off
