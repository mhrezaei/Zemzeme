# Copy to .env (never committed) for development.
OPENROUTER_API_KEY=
# Optional
MY_WHISPER_MODEL=openai/gpt-4o-transcribe
MY_WHISPER_LANG=fa
# Microphone id from `my-whisper mics`; empty = system default
MY_WHISPER_MIC=
# Paste shortcut: ctrl+v | ctrl+shift+v | shift+insert
MY_WHISPER_PASTE_KEY=ctrl+v
# Cleanup step: write English terms in Latin letters (on/off)
MY_WHISPER_CLEANUP=on
MY_WHISPER_CLEANUP_MODEL=google/gemini-3.1-flash-lite
# Words to spell exactly, comma separated
MY_WHISPER_VOCAB=
